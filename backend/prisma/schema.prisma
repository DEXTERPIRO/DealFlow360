generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum QuotationStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_FINANCE
  APPROVED
  REJECTED
  SENT_TO_CUSTOMER
  UNDER_NEGOTIATION
  CONFIRMED
  CANCELLED
}

enum LineType {
  ONE_TIME
  SUBSCRIPTION
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FulfillmentStatus {
  PENDING
  PARTIALLY_FULFILLED
  FULFILLED
  BACKORDERED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum AuditAction {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  SENT
  CONFIRMED
  NEGOTIATED
  FULFILLED
  INVOICED
  PAID
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  email                String         @unique
  password             String
  role                 UserRole       @default(SALES_REP)
  avatar               String?
  isActive             Boolean        @default(true)
  customerTier         CustomerTier?
  companyName          String?
  phone                String?
  magicLinkToken       String?
  magicLinkExpiry      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  quotationsAsRep      Quotation[]    @relation("RepQuotations")
  quotationsAsCustomer Quotation[]    @relation("CustomerQuotations")
  approvals            Approval[]
  auditLogs            AuditLog[]
  notifications        Notification[]
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  maxDiscount Float     @default(15)
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id              String           @id @default(uuid())
  name            String
  sku             String           @unique
  description     String?
  categoryId      String
  basePrice       Decimal          @db.Decimal(12, 2)
  costPrice       Decimal          @db.Decimal(12, 2) @default(0)
  tax             Decimal          @db.Decimal(5, 2)  @default(18)
  unit            String           @default("piece")
  imageUrl        String?
  isActive        Boolean          @default(true)
  isSubscription  Boolean          @default(false)
  billingCycle    BillingCycle?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        ProductCategory  @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  priceLists      PriceListItem[]
  quotationLines  QuotationLine[]
  upsellRules     UpsellRule[]     @relation("SourceProduct")
  upsellTargets   UpsellRule[]     @relation("TargetProduct")
  warehouseStocks WarehouseStock[]
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  name       String
  attribute  String
  value      String
  extraPrice Decimal @db.Decimal(10, 2) @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceList {
  id        String          @id @default(uuid())
  name      String
  tier      CustomerTier
  currency  String          @default("INR")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  items     PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  productId   String
  price       Decimal   @db.Decimal(12, 2)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
}

model DiscountTier {
  id              String       @id @default(uuid())
  tier            CustomerTier
  maxDiscount     Float
  requiresManager Boolean      @default(false)
  requiresFinance Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@unique([tier])
}

model Warehouse {
  id           String            @id @default(uuid())
  name         String
  location     String?
  shippingCost Decimal           @db.Decimal(10, 2) @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  stocks       WarehouseStock[]
  fulfillments FulfillmentLine[]
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model SubscriptionPlan {
  id              String         @id @default(uuid())
  name            String
  billingCycle    BillingCycle
  prorateOnChange Boolean        @default(true)
  cancelPolicy    String?
  partialRefund   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
}

model UpsellRule {
  id              String   @id @default(uuid())
  sourceProductId String
  targetProductId String
  score           Int      @default(50)
  isPromoted      Boolean  @default(false)
  minMargin       Float    @default(0)
  createdAt       DateTime @default(now())
  sourceProduct   Product  @relation("SourceProduct", fields: [sourceProductId], references: [id])
  targetProduct   Product  @relation("TargetProduct", fields: [targetProductId], references: [id])

  @@unique([sourceProductId, targetProductId])
}

model Quotation {
  id               String            @id @default(uuid())
  quotationNumber  String            @unique
  repId            String
  customerId       String?
  customerTier     CustomerTier      @default(BRONZE)
  status           QuotationStatus   @default(DRAFT)
  blendedRiskScore Float             @default(0)
  subtotal         Decimal           @db.Decimal(12, 2) @default(0)
  taxAmount        Decimal           @db.Decimal(12, 2) @default(0)
  discountAmount   Decimal           @db.Decimal(12, 2) @default(0)
  total            Decimal           @db.Decimal(12, 2) @default(0)
  margin           Float             @default(0)
  expiryDate       DateTime?
  portalToken      String?           @unique
  customerNotes    String?
  repNotes         String?
  lastActivityAt   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rep              User              @relation("RepQuotations", fields: [repId], references: [id])
  customer         User?             @relation("CustomerQuotations", fields: [customerId], references: [id])
  lines            QuotationLine[]
  approvals        Approval[]
  fulfillments     FulfillmentLine[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  auditLogs        AuditLog[]
  negotiations     Negotiation[]
}

model QuotationLine {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  variantId   String?
  lineType    LineType  @default(ONE_TIME)
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  costPrice   Decimal   @db.Decimal(12, 2) @default(0)
  discount    Float     @default(0)
  tax         Decimal   @db.Decimal(5, 2)  @default(18)
  lineTotal   Decimal   @db.Decimal(12, 2)
  margin      Float     @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
}

model Approval {
  id          String    @id @default(uuid())
  quotationId String
  approverId  String
  level       Int
  action      String?
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver    User      @relation(fields: [approverId], references: [id])
}

model FulfillmentLine {
  id                String            @id @default(uuid())
  quotationId       String
  warehouseId       String
  productId         String
  quantityNeeded    Int
  quantityFulfilled Int               @default(0)
  status            FulfillmentStatus @default(PENDING)
  isBackorder       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  quotation         Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id])
}

model Subscription {
  id              String           @id @default(uuid())
  quotationId     String
  planId          String
  productId       String
  quantity        Int
  unitPrice       Decimal          @db.Decimal(12, 2)
  startDate       DateTime
  nextBillingDate DateTime
  status          String           @default("ACTIVE")
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  quotation       Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  quotationId   String
  status        InvoiceStatus @default(DRAFT)
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime?
  dueDate       DateTime
  paymentRef    String?
  isRecurring   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  quotation     Quotation     @relation(fields: [quotationId], references: [id])
}

model Negotiation {
  id              String    @id @default(uuid())
  quotationId     String
  requestedBy     String
  message         String
  counterDiscount Float?
  lineId          String?
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String      @id @default(uuid())
  quotationId String?
  userId      String
  action      AuditAction
  details     String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  quotation   Quotation?  @relation(fields: [quotationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
